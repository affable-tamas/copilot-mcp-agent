{
    "$schema": "https://developer.microsoft.com/json-schemas/copilot/plugin/v2.4/schema.json",
    "schema_version": "v2.4",
    "name_for_human": "Copilot MCP spike",
    "description_for_human": "Identifies the signed-in Microsoft 365 user and greets them.",
    "contact_email": "publisher-email@example.com",
    "namespace": "copilotmcpspike",
    "functions": [
        {
            "name": "whoami",
            "description": "Returns the identity of the signed-in Microsoft 365 user calling this server, and the client application they are calling through."
        },
        {
            "name": "greet",
            "description": "Returns a personalised greeting for the signed-in user. Demonstrates using caller identity inside a tool."
        }
    ],
    "runtimes": [
        {
            "type": "RemoteMCPServer",
            "auth": {
                "type": "OAuthPluginVault",
                "reference_id": "${{MCP_DA_AUTH_ID}}"
            },
            "spec": {
                "url": "${{MCP_SERVER_URL}}",
                "mcp_tool_description": {
                    "tools": [
                        {
                            "name": "whoami",
                            "description": "Returns the identity of the signed-in Microsoft 365 user calling this server, and the client application they are calling through.",
                            "inputSchema": {
                                "type": "object",
                                "properties": {}
                            },
                            "annotations": {
                                "readOnlyHint": true,
                                "openWorldHint": false
                            }
                        },
                        {
                            "name": "greet",
                            "description": "Returns a personalised greeting for the signed-in user. Demonstrates using caller identity inside a tool.",
                            "inputSchema": {
                                "$schema": "http://json-schema.org/draft-07/schema#",
                                "type": "object",
                                "properties": {
                                    "language": {
                                        "default": "en",
                                        "description": "Language of the greeting",
                                        "type": "string",
                                        "enum": [
                                            "en",
                                            "hu",
                                            "de",
                                            "fr"
                                        ]
                                    }
                                }
                            },
                            "annotations": {
                                "readOnlyHint": true,
                                "openWorldHint": false
                            }
                        }
                    ]
                }
            },
            "run_for_functions": [
                "whoami",
                "greet"
            ]
        }
    ]
}
