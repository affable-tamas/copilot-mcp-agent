# This file includes environment variables that will be committed to git by default.

# Built-in environment variables
TEAMSFX_ENV=dev
APP_NAME_SUFFIX=dev

# copilot-mcp-spike server and its Entra ID app registration
# (see ../copilot-mcp-spike/README.md, "Entra ID app registration").
# The client secret goes in env/.env.dev.user as SECRET_ENTRA_CLIENT_SECRET.
MCP_SERVER_URL=https://<app>.azurewebsites.net/mcp
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=

# Generated during provision, you can also add your own variables.
TEAMS_APP_ID=
MCP_DA_AUTH_ID=